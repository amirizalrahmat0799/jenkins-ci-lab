# Copy to .env and choose your own password. .env is git-ignored.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# --- Webhook relay (optional) ---------------------------------------------------------
# Uncomment to start the smee relay with "docker compose up -d".
# COMPOSE_PROFILES=webhook
# Your channel from https://smee.io (also the Payload URL of the GitHub webhook)
SMEE_URL=
# Repo the pushes come from, exactly as registered in jobs/projects.groovy
WEBHOOK_REPO_URL=https://github.com/amirizalrahmat0799/payment-gateway-sim.git
# Manage Jenkins -> Security -> Git plugin notifyCommit access tokens -> Add new access token
NOTIFY_COMMIT_TOKEN=
